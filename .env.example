# Firebase web app settings. Never put service-account/private keys in VITE_ values.
VITE_APP_API_KEY=
VITE_APP_AUTH_DOMAIN=
VITE_APP_PROJECT_ID=
VITE_APP_APP_ID=
VITE_APP_STORAGE_BUCKET=
VITE_APP_MESSAGING_SENDER_ID=
# Optional catalog endpoint; the bundled catalog works if it is unavailable.
VITE_CATALOG_URL=
